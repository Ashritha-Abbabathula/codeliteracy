# Gemini API key, used for explanations, the coding assistant, quiz generation, and
# resource recommendations. Free, no billing required: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: raises GitHub's unauthenticated rate limit and allows cloning private repos you own.
GITHUB_TOKEN=

# SQLite by default - no external DB server needed for a student project.
DATABASE_URL=sqlite:///./data/codeliteracy.db

# Where cloned/linked repositories are checked out.
WORKSPACE_DIR=./workspace

# Origin the frontend dev server runs on, for CORS.
FRONTEND_ORIGIN=http://localhost:5173

# Optional: which Gemini model to use for everything. The default is a fast free-tier
# model; a stronger one (if your key has access) gives better explanations and quizzes.
# LLM_MODEL=gemini-3.1-flash-lite
